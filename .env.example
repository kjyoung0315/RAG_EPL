# Copy this file to .env and fill in values. Never commit .env.
# SSAFY GMS key is used first. OPENAI_API_KEY is an optional fallback.
GMS_KEY=
# Override only when SSAFY provides a different GMS endpoint.
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1/
OPENAI_API_KEY=
WIKI_CONTACT=your.name@example.com

# Models can be changed without editing source code.
OPENAI_CHAT_MODEL=gpt-5.4-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5
WIKI_REQUESTS_PER_MINUTE=10
